# ==============================================================================
# India National Pollution Transport & Dispersion Explorer
# Environment Configuration Template (.env.example)
# ==============================================================================
# NOTE: The core application runs 100% offline using pre-calculated 2D Lagrangian
# transport matrices (2019-2024 ERA5 reanalysis) and integrated CPCB/OpenAQ datasets.
# No secret API keys or database passwords are required to run the dashboard.
# ==============================================================================

# Server Network Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Optional: OpenAQ Live API v3 (Used only if fetching fresh real-time station feeds)
# OPENAQ_API_KEY=your_openaq_api_key_here

# Optional: ECMWF Copernicus Climate Data Store (CDS) API (Used only if downloading raw NetCDF)
# CDSAPI_URL=https://cds.climate.copernicus.eu/api/v2
# CDSAPI_KEY=your_uid:your_api_key
